// Grammar for the .schema DSL -- Django-model-like syntax. Matches exactly
// what dsl/render.py emits, so parse(render_snapshot(s)) round-trips.
//
// No explicit "nullable" modifier -- its absence means nullable (Django
// convention); "not_null" is the only way to say otherwise.

start: table_def*

table_def: "table" NAME "{" member* "}"

member: column_def
      | index_def
      | fk_def
      | unique_def
      | check_def

column_def: "column" NAME ":" type_spec modifier*
modifier: "not_null" -> not_null
        | "default" "=" default_value -> default

type_spec: NAME ("(" INT ("," INT)* ")")?

default_value: STRING | SIGNED_NUMBER | NAME

index_def: "index" NAME "on" "(" NAME ("," NAME)* ")" UNIQUE_KW?

UNIQUE_KW: "unique"

fk_def: "foreign_key" "(" NAME ("," NAME)* ")" "references" NAME

unique_def: "unique" "(" NAME ("," NAME)* ")"

check_def: "check" CHECK_EXPR

CHECK_EXPR: /[^\n}]+/

NAME: /[a-zA-Z_][a-zA-Z0-9_]*/
INT: /[0-9]+/
SIGNED_NUMBER: /-?[0-9]+(\.[0-9]+)?/
STRING: /"[^"]*"/

%import common.WS
%ignore WS
%import common.NEWLINE
%ignore NEWLINE
